{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Embedded Engineering Agent",
  "version": "1.3.1-dev.6",
  "identifier": "ai.openai.eea",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-src 'none'; connect-src 'self' http://127.0.0.1:* http://[::1]:* ws://127.0.0.1:* ws://[::1]:*; img-src 'self' blob:; style-src 'self'; script-src 'self'"
    },
    "windows": [
      {
        "title": "Embedded Engineering Agent",
        "width": 1200,
        "height": 760,
        "minWidth": 800,
        "minHeight": 560
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
